# errno -l  Linux 的值逐条和 errno.h 对过，Darwin 的从 XNU 的
# bsd/sys/errno.h 取：两者从 35 起大面积重排，所以按平台分支。
from std.sys import CompilationTarget

comptime EPERM = 1  # 不允许的操作
comptime ENOENT = 2  # 没有那个文件或目录
comptime ESRCH = 3  # 没有那个进程
comptime EINTR = 4  # 被中断的系统调用
comptime EIO = 5  # 输入/输出错误
comptime ENXIO = 6  # 没有那个设备或地址
comptime E2BIG = 7  # 参数列表过长
comptime ENOEXEC = 8  # 可执行文件格式错误
comptime EBADF = 9  # 错误的文件描述符
comptime ECHILD = 10  # 没有子进程
comptime EAGAIN = 35 if CompilationTarget.is_macos() else 11  # 资源暂时不可用
comptime ENOMEM = 12  # 无法分配内存
comptime EACCES = 13  # 权限不够
comptime EFAULT = 14  # 错误的地址
comptime ENOTBLK = 15  # 需要块设备
comptime EBUSY = 16  # 设备或资源忙
comptime EEXIST = 17  # 文件已存在
comptime EXDEV = 18  # 无效的跨设备链接
comptime ENODEV = 19  # 没有那个设备
comptime ENOTDIR = 20  # 不是目录
comptime EISDIR = 21  # 是一个目录
comptime EINVAL = 22  # 无效的参数
comptime ENFILE = 23  # 系统中打开的文件过多
comptime EMFILE = 24  # 打开的文件过多
comptime ENOTTY = 25  # 对设备不适当的 ioctl 操作
comptime ETXTBSY = 26  # 文本文件忙
comptime EFBIG = 27  # 文件过大
comptime ENOSPC = 28  # 设备上没有空间
comptime ESPIPE = 29  # 非法 seek 操作
comptime EROFS = 30  # 只读文件系统
comptime EMLINK = 31  # 过多的链接
comptime EPIPE = 32  # 断开的管道
comptime EDOM = 33  # 数值参数超出定义域
comptime ERANGE = 34  # 数值结果超出值域
comptime EDEADLK = 11 if CompilationTarget.is_macos() else 35  # 已避免资源死锁
comptime ENAMETOOLONG = 63 if CompilationTarget.is_macos() else 36  # 文件名过长
comptime ENOLCK = 77 if CompilationTarget.is_macos() else 37  # 没有可用的锁
comptime ENOSYS = 78 if CompilationTarget.is_macos() else 38  # 函数未实现
comptime ENOTEMPTY = 66 if CompilationTarget.is_macos() else 39  # 目录非空
comptime ELOOP = 62 if CompilationTarget.is_macos() else 40  # 符号链接的层数过多
comptime EWOULDBLOCK = 35 if CompilationTarget.is_macos() else 11  # 资源暂时不可用
comptime ENOMSG = 91 if CompilationTarget.is_macos() else 42  # 没有所需类型的消息
comptime EIDRM = 90 if CompilationTarget.is_macos() else 43  # 标识符已删除
comptime ECHRNG = 44  # 通道编号超出范围
comptime EL2NSYNC = 45  # 级别 2 尚未同步
comptime EL3HLT = 46  # 级别 3 已关闭
comptime EL3RST = 47  # 级别 3 已重置
comptime ELNRNG = 48  # 链接数超出范围
comptime EUNATCH = 49  # 未加载协议驱动程序
comptime ENOCSI = 50  # 没有可用的 CSI 结构
comptime EL2HLT = 51  # 级别 2 己关闭
comptime EBADE = 52  # 无效的交换
comptime EBADR = 53  # 无效的请求描述符
comptime EXFULL = 54  # 交换满
comptime ENOANO = 55  # 没有 anode
comptime EBADRQC = 56  # 无效的请求码
comptime EBADSLT = 57  # 无效的 slot
comptime EDEADLOCK = 35  # 已避免资源死锁
comptime EBFONT = 59  # 错误的字体文件格式
comptime ENOSTR = 99 if CompilationTarget.is_macos() else 60  # 设备不是流
comptime ENODATA = 96 if CompilationTarget.is_macos() else 61  # 没有可用的数据
comptime ETIME = 101 if CompilationTarget.is_macos() else 62  # 计时器过期
comptime ENOSR = 98 if CompilationTarget.is_macos() else 63  # 流资源不足
comptime ENONET = 64  # 机器不在网络中
comptime ENOPKG = 65  # 包未安装
comptime EREMOTE = 71 if CompilationTarget.is_macos() else 66  # 对象是远程的
comptime ENOLINK = 97 if CompilationTarget.is_macos() else 67  # 链接已被切断
comptime EADV = 68  # 通知错误
comptime ESRMNT = 69  # Srmount 错误
comptime ECOMM = 70  # 发送时出现通讯错误
comptime EPROTO = 100 if CompilationTarget.is_macos() else 71  # 协议错误
comptime EMULTIHOP = 95 if CompilationTarget.is_macos() else 72  # 试图多跳
comptime EDOTDOT = 73  # RFS 特定错误
comptime EBADMSG = 94 if CompilationTarget.is_macos() else 74  # 错误的消息
comptime EOVERFLOW = 84 if CompilationTarget.is_macos() else 75  # 对已定义的数据类型来说值过大
comptime ENOTUNIQ = 76  # 网络上的名称不是唯一的
comptime EBADFD = 77  # 文件描述符处于错误状态
comptime EREMCHG = 78  # 远程地址已改变
comptime ELIBACC = 79  # 无法访问必需的共享库
comptime ELIBBAD = 80  # 访问已损坏的共享库
comptime ELIBSCN = 81  # a.out 中的 .lib 节已毁坏
comptime ELIBMAX = 82  # 试图与过多的共享库相链接
comptime ELIBEXEC = 83  # 无法直接执行共享库
comptime EILSEQ = 92 if CompilationTarget.is_macos() else 84  # 无效或不完整的多字节字符或宽字符
comptime ERESTART = 85  # 被中断的系统调用应当重新启动
comptime ESTRPIPE = 86  # 流管道错误
comptime EUSERS = 68 if CompilationTarget.is_macos() else 87  # 用户过多
comptime ENOTSOCK = 38 if CompilationTarget.is_macos() else 88  # 对非套接字进行套接字操作
comptime EDESTADDRREQ = 39 if CompilationTarget.is_macos() else 89  # 需要目标地址
comptime EMSGSIZE = 40 if CompilationTarget.is_macos() else 90  # 消息过长
comptime EPROTOTYPE = 41 if CompilationTarget.is_macos() else 91  # 用于套接字的协议类型错误
comptime ENOPROTOOPT = 42 if CompilationTarget.is_macos() else 92  # 不可用的协议
comptime EPROTONOSUPPORT = 43 if CompilationTarget.is_macos() else 93  # 不支持的协议
comptime ESOCKTNOSUPPORT = 44 if CompilationTarget.is_macos() else 94  # 不支持的套接字类型
comptime EOPNOTSUPP = 102 if CompilationTarget.is_macos() else 95  # 不支持的操作
comptime EPFNOSUPPORT = 46 if CompilationTarget.is_macos() else 96  # 不支持的协议族
comptime EAFNOSUPPORT = 47 if CompilationTarget.is_macos() else 97  # 协议不支持的地址族
comptime EADDRINUSE = 48 if CompilationTarget.is_macos() else 98  # 地址已在使用
comptime EADDRNOTAVAIL = 49 if CompilationTarget.is_macos() else 99  # 无法分配被请求的地址
comptime ENETDOWN = 50 if CompilationTarget.is_macos() else 100  # 网络已关闭
comptime ENETUNREACH = 51 if CompilationTarget.is_macos() else 101  # 网络不可达
comptime ENETRESET = 52 if CompilationTarget.is_macos() else 102  # 网络连接在重置时断开
comptime ECONNABORTED = 53 if CompilationTarget.is_macos() else 103  # 由软件导致的连接中止
comptime ECONNRESET = 54 if CompilationTarget.is_macos() else 104  # 连接被对方重置
comptime ENOBUFS = 55 if CompilationTarget.is_macos() else 105  # 没有可用的缓冲区空间
comptime EISCONN = 56 if CompilationTarget.is_macos() else 106  # 传输端点已连接
comptime ENOTCONN = 57 if CompilationTarget.is_macos() else 107  # 传输端点尚未连接
comptime ESHUTDOWN = 58 if CompilationTarget.is_macos() else 108  # 无法在传输端点关闭以后发送
comptime ETOOMANYREFS = 59 if CompilationTarget.is_macos() else 109  # 过多的引用：无法接合
comptime ETIMEDOUT = 60 if CompilationTarget.is_macos() else 110  # 连接超时
comptime ECONNREFUSED = 61 if CompilationTarget.is_macos() else 111  # 连接被拒绝
comptime EHOSTDOWN = 64 if CompilationTarget.is_macos() else 112  # 主机已关闭
comptime EHOSTUNREACH = 65 if CompilationTarget.is_macos() else 113  # 没有到主机的路由
comptime EALREADY = 37 if CompilationTarget.is_macos() else 114  # 操作已经在进行
comptime EINPROGRESS = 36 if CompilationTarget.is_macos() else 115  # 操作现在正在进行
comptime ESTALE = 70 if CompilationTarget.is_macos() else 116  # 过旧的文件句柄
comptime EUCLEAN = 117  # 结构需要清理
comptime ENOTNAM = 118  # 不是 XENIX 命名类型文件
comptime ENAVAIL = 119  # 没有可用的 XENIX 信号量
comptime EISNAM = 120  # 是一个命名类型文件
comptime EREMOTEIO = 121  # 远程 I/O 错误
comptime EDQUOT = 69 if CompilationTarget.is_macos() else 122  # 超出磁盘配额
comptime ENOMEDIUM = 123  # 找不到介质
comptime EMEDIUMTYPE = 124  # 错误的介质类型
comptime ECANCELED = 89 if CompilationTarget.is_macos() else 125  # 操作已取消
comptime ENOKEY = 126  # 需要的密钥不存在
comptime EKEYEXPIRED = 127  #  密钥已过期
comptime EKEYREVOKED = 128  # 密钥已被撤销
comptime EKEYREJECTED = 129  # 密钥被服务拒绝
comptime EOWNERDEAD = 105 if CompilationTarget.is_macos() else 130  # 拥有者已结束
comptime ENOTRECOVERABLE = 104 if CompilationTarget.is_macos() else 131  # 状态无法恢复
comptime ERFKILL = 132  # 由于 RF-kill 而无法操作
comptime EHWPOISON = 133  # 内存页有硬件错误
comptime ENOTSUP = 45 if CompilationTarget.is_macos() else 95  # 不支持的操作
